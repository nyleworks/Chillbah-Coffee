---
import '../styles/global.css';
import { site } from '../data/site';
import pixelifyUrl from '../assets/fonts/pixelify-sans-700.woff2?url';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // site may live in a subfolder (GitHub Pages)
interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;
// Absolute URLs for link previews: `site` + `base` from astro.config (change there if the site moves to its own domain).
const pageUrl = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const ogImage = new URL(`${B}og-image.png`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <!-- Link preview (WhatsApp, Facebook, Instagram DMs, X, Slack...). Image must be an absolute URL. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chillbah Coffee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:locale" content="en_MY" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4ebcd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211812" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${B}favicon.svg`} type="image/svg+xml" />
    <!-- Fonts ship with the site (styles/tokens.css). Only the small heading font is fetched ahead, so the CHILLBAH title
         doesn't flash in a stand-in font; the rest load alongside without competing with the stylesheet. -->
    <link rel="preload" href={pixelifyUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try { const t = localStorage.getItem('chillbah-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
      // Reduce motion: the header button's saved choice, else the device setting (src/lib/motion.ts).
      (function () {
        let m = null;
        try { m = localStorage.getItem('chillbah-motion'); } catch (e) {}
        document.documentElement.dataset.motion = m || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduce' : 'full');
      })();
    </script>
  </head>
  <body>
    <a class="skip cb-btn cb-btn--ghost" href="#top">Skip to content</a>
    <slot />
  </body>
</html>
