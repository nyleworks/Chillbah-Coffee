---
import Ticker from './Ticker.astro';
import Truck from './Truck.astro';
---
<section class="hero">
  <!-- The top of the Where we at card peeks up just above the ticker and bobs. It stays at the bottom of the screen through the
       whole scroll story and after the hero leaves, until the real card scrolls up into its place, then hands over to it. -->
  <div class="peek-dock" id="peekDock">
    <a class="peek" href="#find" aria-label="Scroll to Where we at">
      <span class="label peek-kicker">Where we at</span>
      <span class="peek-title">WE MOVE. YOU FOLLOW.</span>
    </a>
  </div>
  <!-- Scroll story: the scene pins under the header while you scroll this track; scripts/story.ts drives it. -->
  <div class="scene-track" id="sceneTrack">
    <!-- Pinned together: the scene plus the ticker strip under it, so the strip shows on the first screen too. -->
    <div class="scene-pin" id="sceneFrame">
    <div class="scene-frame">
      <div class="stage" id="sceneStage">
      <canvas id="scene" width="180" height="106" aria-hidden="true"></canvas>
      <Truck id="heroTruck" class="hilux" awning label="Pixel art of the white Chillbah Hilux with its black side awning, parked on grass with mountains behind" />
      <img class="barista" id="barista" src="/barista.png" width="32" height="64" alt="Pixel art of the Chillbah barista in a green Chillbah apron with a backpack, standing beside the truck" />
      </div>
      <div class="hero-copy">
        <h1 class="title">CHILLBAH</h1>
        <div class="ctas">
          <a class="cb-btn" href="#find">Find the truck</a>
          <a class="cb-btn cb-btn--ghost" href="#menu">See menu</a>
        </div>
      </div>
    </div>
    <Ticker />
    </div>
  </div>
</section>

<script>
  // Keep the tab docked at the bottom of the screen, then hide it the moment the real card's top reaches it.
  const dock = document.getElementById('peekDock');
  const card = document.querySelector<HTMLElement>('#find .find-card');
  const peek = dock?.querySelector<HTMLElement>('.peek');
  function place() {
    if (!dock || !card || !peek) return;
    // the tab's visible top edge (it bobs, so measure it live); the real card takes over once its top gets there
    dock.classList.toggle('handed', card.getBoundingClientRect().top <= peek.getBoundingClientRect().top + 2);
  }
  addEventListener('scroll', place, { passive: true }); addEventListener('resize', place); place();
</script>

<style>
  .hero { padding: 0; text-align: center; }
  .scene-track { position: relative; }
  /* Full-bleed scene filling the screen under the header. The 180×106 art is pinned to the bottom at full width:
     on tall screens plain sky fills the space above it, on wide screens the top of the sky is trimmed. */
  .scene-frame { position: relative; width: 100%; height: calc(100svh - 64px - 43px); min-height: 200px; /* 43px = ticker strip */ overflow: hidden;
    background: var(--sky); border-bottom: 3px solid var(--line); container-type: size; }
  :global(html.story) .scene-track { height: calc(var(--frame-h, 60vw) + 156vh); }
  :global(html.story) .scene-pin { position: sticky; top: 64px; }
    /* The stage holds the art, truck and barista. Full width on most screens; on tall phones it grows so the scene fills
     about half the height, centred on the truck (the sign and stools drop off the sides), never leaving a gap at either edge. */
  .stage { position: absolute; bottom: 0; width: max(100cqw, 92cqh); aspect-ratio: 180 / 106; left: clamp(calc(100% - max(100cqw, 92cqh)), calc(50% - 0.48 * max(100cqw, 92cqh)), 0px); container-type: inline-size; }
  .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Sizes are in cqw (stage width) so the truck and barista stay on the road. */
  .stage :global(.hilux) { position: absolute; left: 25.6%; width: 38.9%; bottom: 5.8cqw; }
  .barista { position: absolute; left: 65%; width: 6.1%; height: auto; bottom: 6.07cqw; image-rendering: pixelated; will-change: transform; }

  /* Wordmark and buttons sit in the sky, over the art. */
  .hero-copy { position: absolute; z-index: 2; left: 0; right: 0; top: max(16px, calc((100cqh - max(58.9cqw, 50cqh)) * 0.4 + 4cqw)); display: grid; justify-items: center; gap: clamp(12px, 2.4cqw, 28px); padding: 0 16px; }
  .title { margin: 0; font: 700 clamp(40px, min(12cqw, 24cqh), 156px)/.9 var(--font-display); color: var(--ember-600); letter-spacing: .03em;
    text-shadow: 3px 3px 0 var(--brick), 6px 6px 0 var(--brick); }
  .ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  /* Peeking card: only its top ~56px shows above the scene's bottom edge (the frame clips the rest). */
  .peek-dock { position: fixed; z-index: 5; left: 0; right: 0; bottom: 43px; height: 96px; overflow: hidden; pointer-events: none; }
  .peek-dock.handed { visibility: hidden; }
  .peek { position: absolute; left: 50%; bottom: 0; width: min(640px, calc(100% - 32px)); height: 120px; box-sizing: border-box; pointer-events: auto;
    display: flex; flex-direction: column; align-items: center; gap: 8px; padding-top: 14px; text-decoration: none;
    background: var(--surface-100); border: 3px solid var(--line); box-shadow: 6px 6px 0 var(--line);
    transform: translate(-50%, calc(100% - 58px)); animation: peek-bob 1.8s ease-in-out infinite; }
  .peek-kicker { color: var(--ember-600); font-size: 11px; }
  .peek-title { font: 700 clamp(18px, 3vw, 26px)/1 var(--font-display); color: var(--forest); letter-spacing: .02em; }
  .peek:focus-visible { outline: 3px dashed var(--forest); outline-offset: 4px; }
  /* Soft jump: rises a little, settles back, with a tiny squash on landing. */
  @keyframes peek-bob {
    0%, 100% { transform: translate(-50%, calc(100% - 58px)); }
    40% { transform: translate(-50%, calc(100% - 74px)); }
    70% { transform: translate(-50%, calc(100% - 56px)); }
  }
  @media (prefers-reduced-motion: reduce) { .peek { animation: none; } }
  /* Phones: lift the whole scene above a plain grass strip, and use a smaller tab, so the peek never covers the truck. */
  @media (max-width: 560px) {
    .stage { bottom: 52px; }
    .scene-frame::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 53px; background: var(--ground, #7fae45); }
    .peek { width: 64%; padding-top: 10px; gap: 6px; transform: translate(-50%, calc(100% - 44px)); animation-name: peek-bob-sm; box-shadow: 4px 4px 0 var(--line); }
    .peek-title { font-size: 14px; }
    .peek-kicker { font-size: 9px; }
  }
  @keyframes peek-bob-sm {
    0%, 100% { transform: translate(-50%, calc(100% - 44px)); }
    40% { transform: translate(-50%, calc(100% - 56px)); }
    70% { transform: translate(-50%, calc(100% - 42px)); }
  }
  /* Short screens (phones held sideways): smaller buttons so the title, buttons and truck all fit. */
  @media (max-height: 500px) { .ctas .cb-btn { padding: 8px 12px; font-size: 11px; } .hero-copy { gap: 10px; } }
  @media (max-width: 560px) {
    .title { font-size: min(15cqw, 72px); text-shadow: 2px 2px 0 var(--brick), 4px 4px 0 var(--brick); }
    .ctas { gap: 10px; }
    .ctas .cb-btn { padding: 8px 10px; font-size: 11px; box-shadow: 3px 3px 0 var(--line); }
  }
</style>
