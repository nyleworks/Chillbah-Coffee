---
import Truck from './Truck.astro';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // site may live in a subfolder (GitHub Pages)
---
<section class="hero">
  <!-- Scroll story: the scene pins under the header while you scroll this track; scripts/story.ts drives it. -->
  <div class="scene-track" id="sceneTrack">
    <div class="scene-pin" id="sceneFrame">
    <div class="scene-frame">
      <div class="stage" id="sceneStage">
      <canvas id="scene" width="180" height="106" aria-hidden="true"></canvas>
      <Truck id="heroTruck" class="hilux" awning hero label="Pixel art of the white Chillbah Hilux with its tan side awning open on poles, parked on grass with mountains behind" />
      <img class="barista" id="barista" src={`${B}barista.png`} width="32" height="64" alt="Pixel art of the Chillbah barista in a green Chillbah apron with a backpack, standing beside the truck" />
      <!-- The menu stand: tap it and it bobs, then the page goes to the menu. A bouncing "Menu" arrow above hints that it's tappable. -->
      <button class="menu-stand" id="menuStand" type="button" aria-label="See the menu">
        <span class="stand-hint" aria-hidden="true"><b>Menu</b><i></i></span>
        <canvas id="standArt" width="10" height="14" aria-hidden="true"></canvas>
      </button>
      </div>
      <!-- Scene switch, bottom right of the hero: flips between the mountain and the jetty (scene.ts draws both; index.astro wires it). -->
      <button class="cb-btn cb-btn--alt scene-btn" id="sceneBtn" type="button" aria-label="Change scene to the jetty">
        <!-- Which scene is showing: 1 Mount Kinabalu, 2 the jetty, 3 the night market (index.astro marks the current one). -->
        <span class="scene-dots" aria-hidden="true"><i data-n="hills">1</i><i data-n="jetty">2</i><i data-n="market">3</i></span>
        <!-- Phones show this pixel icon instead of the words: a framed landscape with a swap arrow. -->
        <svg class="scene-icon" viewBox="0 0 16 16" width="24" height="24" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="1" height="1"/><rect x="1" y="0" width="1" height="1"/><rect x="2" y="0" width="1" height="1"/><rect x="3" y="0" width="1" height="1"/><rect x="4" y="0" width="1" height="1"/><rect x="5" y="0" width="1" height="1"/><rect x="6" y="0" width="1" height="1"/><rect x="7" y="0" width="1" height="1"/><rect x="8" y="0" width="1" height="1"/><rect x="9" y="0" width="1" height="1"/><rect x="10" y="0" width="1" height="1"/><rect x="11" y="0" width="1" height="1"/><rect x="0" y="1" width="1" height="1"/><rect x="11" y="1" width="1" height="1"/><rect x="0" y="2" width="1" height="1"/><rect x="8" y="2" width="1" height="1" fill="#f2c94c"/><rect x="9" y="2" width="1" height="1" fill="#f2c94c"/><rect x="11" y="2" width="1" height="1"/><rect x="0" y="3" width="1" height="1"/><rect x="4" y="3" width="1" height="1"/><rect x="8" y="3" width="1" height="1" fill="#f2c94c"/><rect x="9" y="3" width="1" height="1" fill="#f2c94c"/><rect x="11" y="3" width="1" height="1"/><rect x="0" y="4" width="1" height="1"/><rect x="3" y="4" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/><rect x="5" y="4" width="1" height="1"/><rect x="11" y="4" width="1" height="1"/><rect x="0" y="5" width="1" height="1"/><rect x="2" y="5" width="1" height="1"/><rect x="3" y="5" width="1" height="1"/><rect x="4" y="5" width="1" height="1"/><rect x="5" y="5" width="1" height="1"/><rect x="6" y="5" width="1" height="1"/><rect x="8" y="5" width="1" height="1"/><rect x="11" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="1" y="6" width="1" height="1"/><rect x="2" y="6" width="1" height="1"/><rect x="3" y="6" width="1" height="1"/><rect x="4" y="6" width="1" height="1"/><rect x="5" y="6" width="1" height="1"/><rect x="6" y="6" width="1" height="1"/><rect x="7" y="6" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/><rect x="9" y="6" width="1" height="1"/><rect x="11" y="6" width="1" height="1"/><rect x="0" y="7" width="1" height="1"/><rect x="1" y="7" width="1" height="1"/><rect x="2" y="7" width="1" height="1"/><rect x="3" y="7" width="1" height="1"/><rect x="4" y="7" width="1" height="1"/><rect x="5" y="7" width="1" height="1"/><rect x="6" y="7" width="1" height="1"/><rect x="10" y="8" width="1" height="1"/><rect x="11" y="8" width="1" height="1"/><rect x="12" y="8" width="1" height="1"/><rect x="13" y="8" width="1" height="1"/><rect x="15" y="8" width="1" height="1"/><rect x="9" y="9" width="1" height="1"/><rect x="14" y="9" width="1" height="1"/><rect x="15" y="9" width="1" height="1"/><rect x="8" y="10" width="1" height="1"/><rect x="13" y="10" width="1" height="1"/><rect x="14" y="10" width="1" height="1"/><rect x="15" y="10" width="1" height="1"/><rect x="8" y="11" width="1" height="1"/><rect x="8" y="12" width="1" height="1"/><rect x="15" y="12" width="1" height="1"/><rect x="8" y="13" width="1" height="1"/><rect x="15" y="13" width="1" height="1"/><rect x="9" y="14" width="1" height="1"/><rect x="14" y="14" width="1" height="1"/><rect x="10" y="15" width="1" height="1"/><rect x="11" y="15" width="1" height="1"/><rect x="12" y="15" width="1" height="1"/><rect x="13" y="15" width="1" height="1"/></svg>
        <span class="scene-word">Change scene</span>
      </button>
      <!-- The open sky above the mountain peak; the wordmark and buttons are centred in it. -->
      <div class="hero-copy">
        <h1 class="title">CHILLBAH</h1>
        <div class="ctas">
          <a class="cb-btn" href="#find">Locate Us</a>
          <a class="cb-btn cb-btn--ghost" href="#events">Catch Us</a>
        </div>
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: 0; text-align: center; }
  .scene-track { position: relative; }
  /* Full-bleed scene filling the screen under the header (ticker + nav). The 180×106 art is pinned to the bottom: plain sky
     fills the space above it. On wide screens the art stops growing once it's as tall as the screen, so the mountain never runs
     up into the header; scene.ts then extends the sky, ground and road out to the screen edges on either side. */
  .scene-frame { position: relative; width: 100%; height: calc(100svh - var(--header-h) + 3px); min-height: 200px; overflow: hidden;
    background: var(--sky); border-bottom: 3px solid var(--line); container-type: size;
    --stage-w: min(max(100cqw, 92cqh), 100cqh * 180 / 106); /* art width */
    --art-h: calc(var(--stage-w) * 106 / 180);
    --lift: 0px; /* phones raise the art above a grass strip */ }
  :global(html.story) .scene-track { height: calc(var(--frame-h, 60vw) + 156vh); height: calc(var(--frame-h, 60vw) + 156lvh); } /* lvh: steady while the phone address bar slides */
  :global(html.story) .scene-pin { position: sticky; top: calc(var(--header-h) - 3px); }
    /* The stage holds the art, truck and barista. Full width on most screens; on tall phones it grows so the scene fills
     about half the height, centred on the truck (the sign and stools drop off the sides), never leaving a gap at either edge. */
  .stage { position: absolute; bottom: 0; width: var(--stage-w); aspect-ratio: 180 / 106; left: clamp(calc(100% - var(--stage-w)), calc(50% - 0.48 * var(--stage-w)), 0px); container-type: inline-size; }
  /* Screens wider than the art (wide monitors): the art is as tall as the screen and sits in the middle. */
  @container (min-aspect-ratio: 180 / 106) { .stage { left: calc(50% - var(--stage-w) / 2); } }
  /* Phones: lift the scene above a strip of ground so the docked Where we at card (FindUs.astro) shows in full under the truck. */
  @media (max-width: 560px) {
    .stage { bottom: 96px; }
    .scene-frame { --lift: 96px; }
    /* scene.ts grows the canvas down over the strip (grass under the mountain, the water under the jetty); this is only the
       backdrop until it paints */
    .scene-frame { background: linear-gradient(to top, var(--ground, #7fae45) 97px, var(--sky) 97px); }
  }
  .stage canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; } /* scene.ts widens it to the frame on wide screens */
  /* Sizes are in cqw (stage width) so the truck and barista stay on the road. */
  .stage :global(.hilux) { position: absolute; left: 25.6%; width: 38.9%; bottom: 5.8cqw; z-index: 3; } /* above the menu stand, so it rolls past in front */
  .barista { position: absolute; left: 65%; width: 6.1%; height: auto; bottom: 6.07cqw; image-rendering: pixelated; will-change: transform; z-index: 4; } /* in front of the truck */

  /* Menu stand: sits exactly where the board used to be painted (world 70,96, 10×14 art px; 1 art px = 100cqw / 180). */
  .menu-stand { position: absolute; z-index: 2; left: calc(30cqw * 100 / 180); top: calc(78cqw * 100 / 180); width: calc(10cqw * 100 / 180); height: calc(14cqw * 100 / 180);
    padding: 0; border: 0; background: none; cursor: pointer; }
  .menu-stand canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }
  .menu-stand:hover canvas { transform: translateY(calc(-100cqw / 180)); }
  .menu-stand:focus-visible { outline: 3px dashed var(--forest); outline-offset: 4px; }
  .menu-stand.bob canvas { animation: stand-bob .48s steps(1) both; }
  @keyframes stand-bob { 0% { transform: translateY(0); } 17% { transform: translateY(calc(-200cqw / 180)); } 34% { transform: translateY(0); }
    51% { transform: translateY(calc(-100cqw / 180)); } 68%, 100% { transform: translateY(0); } }
  /* The hint: a small "Menu" tag with a pixel arrow pointing down at the board, hopping every couple of seconds. */
  .stand-hint { position: absolute; left: 50%; bottom: calc(100% + 4px); display: grid; justify-items: center; gap: 3px; pointer-events: none;
    transform: translateX(-50%); animation: hint-hop 1.6s steps(1) infinite; }
  .stand-hint b { padding: 3px 5px; background: var(--ember); color: #fff6dc; border: 2px solid var(--line); box-shadow: 2px 2px 0 var(--line);
    font: 700 11px/1 var(--font-pixel); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .stand-hint i { width: 18px; height: 10px; background: var(--ember); clip-path: polygon(0 0, 100% 0, 100% 25%, 86% 25%, 86% 50%, 71% 50%, 71% 75%, 57% 75%, 57% 100%, 43% 100%, 43% 75%, 29% 75%, 29% 50%, 14% 50%, 14% 25%, 0 25%); }
  @keyframes hint-hop { 0%, 60%, 100% { transform: translate(-50%, 0); } 70% { transform: translate(-50%, -5px); } 80% { transform: translate(-50%, 0); } 90% { transform: translate(-50%, -3px); } }
  .menu-stand.bob .stand-hint { opacity: 0; }
  :global(html[data-motion="reduce"]) .stand-hint, :global(html[data-motion="reduce"]) .menu-stand.bob canvas { animation: none; }
  @media (max-width: 560px) { .stand-hint b { font-size: 9px; padding: 2px 4px; } }

  /* Scene switch: the green pixel button, bottom right of the hero (on phones, just above the grass/sea strip). */
  .scene-btn { position: absolute; z-index: 3; right: 16px; bottom: calc(var(--lift) + 16px); padding: 10px 14px; font-size: 12px; }
  /* Tablets: the docked Where we at card is nearly as wide as the screen, so the button sits above where it peeks in. */
  /* Scene number tab tucked over the button's top-left corner, like the menu's HOT stickers; the current scene is lit. */
  .scene-dots { position: absolute; top: -19px; left: -8px; display: flex; gap: 2px; padding: 2px; background: var(--line);
    border: 2px solid var(--line); box-shadow: 2px 2px 0 var(--line); }
  .scene-dots i { display: grid; place-items: center; width: 15px; height: 15px; font: 700 10px/1 var(--font-pixel); font-style: normal;
    background: var(--surface-100); color: var(--muted); }
  .scene-dots i.on { background: var(--ember); color: #fff6dc; }
  @media (max-width: 560px) { .scene-dots { top: -17px; left: -6px; } .scene-dots i { width: 13px; height: 13px; font-size: 9px; } }
  @media (min-width: 561px) and (max-width: 1060px) { .scene-btn { bottom: 64px; } }
  .scene-icon { display: none; }
  /* Phones: just the icon, in a small square button. */
  @media (max-width: 560px) {
    .scene-btn { right: 12px; bottom: calc(var(--lift) + 10px); padding: 6px; box-shadow: 3px 3px 0 var(--line); }
    .scene-word { display: none; }
    .scene-icon { display: block; width: 32px; height: 32px; }
  }

  /* Wordmark and buttons sit in the open sky: centred between the header and the mountain peak (the peak is about 30% down
     the art), with at least 24px clear above. */
  .hero-copy { position: absolute; z-index: 2; left: 0; right: 0; top: 0; height: max(160px, calc(100cqh - var(--lift) - var(--art-h) * 0.7)); padding: 24px 16px 12px;
    display: grid; align-content: center; justify-items: center; gap: clamp(12px, 2cqw, 24px); }
  .title { margin: 0; font: 700 clamp(40px, min(10cqw, 17cqh), 128px)/.9 var(--font-display); color: var(--ember-600); letter-spacing: .03em;
    text-shadow: 3px 3px 0 var(--brick), 6px 6px 0 var(--brick); }
  .ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  /* Short screens (phones held sideways): smaller buttons so the title, buttons and truck all fit. */
  @media (max-height: 500px) { .ctas .cb-btn { padding: 8px 12px; font-size: 11px; } .hero-copy { gap: 10px; } }
  @media (max-width: 560px) {
    .title { font-size: min(15cqw, 72px); text-shadow: 2px 2px 0 var(--brick), 4px 4px 0 var(--brick); }
    .ctas { gap: 10px; }
    .ctas .cb-btn { padding: 8px 10px; font-size: 11px; box-shadow: 3px 3px 0 var(--line); }
  }
</style>
