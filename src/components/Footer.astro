---
const year = new Date().getFullYear();
---
<footer>
  <canvas data-grass width="320" height="8" aria-hidden="true"></canvas>
  <div class="wrap foot">
    <b>CHILLBAH</b>
    <span class="label">© {year} Chillbah · Coffee on four wheels</span>
  </div>
</footer>

<style>
  footer { border-top: 3px solid var(--line); }
  canvas { width: 100%; height: 32px; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 24px 0 32px; }
  b { font: 700 22px/1 var(--font-display); color: var(--forest); }
  .label { color: var(--muted); }
</style>
