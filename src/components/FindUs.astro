---
import { site } from '../data/site';
import RoadLane from './RoadLane.astro';
import { hours } from '../data/events';
const rows = [
  { icon: 'pin', title: 'Pin drops each morning', text: 'Check our socials before you head out.' },
  { icon: 'clock', title: 'Open till sold out', text: 'When the beans run out, we roll on.' },
  { icon: 'truck', title: 'Look for the white Hilux', text: 'Black side awning over the tray.' },
];
---
<div class="pin-track">
<section id="find" class="find">
  <div class="wrap">
    <!-- One floating card, centred: heading, intro, today's spot and the social links together. -->
    <div class="find-dock" id="findDock">
      <div class="find-card" id="findCard">
        <div class="label kicker">Where we at</div>
        <h2>WE MOVE.<br />YOU FOLLOW.</h2>
        <div class="spot">
          <div class="cb-tag cb-tag--live">Today's spot</div>
          {rows.map((r) => (
            <div class="row">
              <canvas data-icon={r.icon} width="8" height="8" aria-hidden="true"></canvas>
              <div><b>{r.title}</b><span>{r.text}</span></div>
            </div>
          ))}
        </div>
        <div class="hours">
          <div class="label hours-head">Opening hours <span>Placeholder</span></div>
          <table>
            <tbody>
              {hours.map((h) => <tr><th scope="row">{h.day}</th><td>{h.time}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="ctas">
          <a class="cb-btn cb-btn--alt" href={site.instagram}>Instagram</a>
          <a class="cb-btn cb-btn--ghost" href={site.whatsapp}>WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
  <RoadLane dir="rtl" scenery="village" />
</section>
</div>

<script>
  // While the visitor is still above this section, the card is lifted to dock on the bottom edge of the screen, showing only
  // its top (kicker + first heading line), and bobs there. It stays docked while they scroll; once the card's real
  // position reaches the dock it lets go and sits in place. The dock wrapper does the lifting and the (static) clipping,
  // the card inside does the bobbing, so the slice always rises out of the same edge. Off under reduced motion.
  const dock = document.getElementById('findDock');
  const card = document.getElementById('findCard');
  if (dock && card && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const h2 = card.querySelector('h2')!;
    const truck = document.getElementById('heroTruck');
    let raf = 0;
    const update = () => {
      raf = 0;
      const firstLine = parseFloat(getComputedStyle(h2).lineHeight) || h2.offsetHeight / 2;
      const visible = Math.round(h2.offsetTop + firstLine + 10); // down to just under the first heading line
      // rests on the bottom edge of the screen, but never higher than just under the hero truck's tyres
      // (with room for the bob), so on short screens it doesn't cover the truck
      const tyres = truck ? truck.getBoundingClientRect().bottom + 20 : 0;
      const dockTop = Math.max(innerHeight - visible, tyres);
      const wrap = dock.parentElement!; // untransformed, so it gives the dock's natural position
      const naturalTop = wrap.getBoundingClientRect().top + dock.offsetTop - wrap.offsetTop;
      const lift = Math.min(0, Math.round(dockTop - naturalTop));
      const docked = lift < 0;
      dock.style.transform = docked ? `translateY(${lift}px)` : '';
      dock.style.clipPath = docked ? `polygon(-40px -60px, calc(100% + 40px) -60px, calc(100% + 40px) ${visible}px, -40px ${visible}px)` : '';
      dock.classList.toggle('docked', docked);
    };
    const request = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();
    // the page grows after load (fonts, scroll-story track sizing), which moves the card without a scroll event
    new ResizeObserver(request).observe(document.body);
    addEventListener('load', request);
    document.fonts?.ready.then(request);
    // tapping the docked slice scrolls down to the section
    dock.addEventListener('click', (e) => {
      if (!dock.classList.contains('docked') || (e.target as HTMLElement).closest('a')) return;
      document.getElementById('find')?.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>

<style>
  .find { background: var(--surface-200); border-block: 3px solid var(--line); padding-bottom: 0; }
  .find :global(.lane) { margin-top: 56px; }
  .find-card { max-width: 640px; margin: 0 auto; text-align: center; background: var(--surface-100); border: 3px solid var(--line);
    box-shadow: 8px 8px 0 var(--line), 16px 16px 0 rgba(18, 18, 13, .18); padding: clamp(24px, 5vw, 44px); }
  .find-card h2 { margin-top: 8px; }
  .spot { text-align: left; margin-top: 24px; padding-top: 20px; border-top: 3px solid var(--line); }
  /* Docked (see script): the wrapper is lifted and clipped; the card bobs inside it, rising out of the clip edge. */
  .find-dock { position: relative; z-index: 6; }
  .find-dock.docked { cursor: pointer; }
  .find-dock.docked .find-card { animation: card-bob 1.8s ease-in-out infinite; }
  @keyframes card-bob { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-16px); } 70% { transform: translateY(2px); } }
  @media (max-width: 560px) { .find-card { box-shadow: 5px 5px 0 var(--line), 10px 10px 0 rgba(18, 18, 13, .18); } }
  .row { display: flex; gap: 14px; align-items: center; padding: 14px 0; border-bottom: 2px dashed var(--line); }
  .row:last-of-type { border-bottom: 0; }
  .row canvas { width: 32px; height: 32px; flex: none; }
  .row b { display: block; font: 700 16px/1.2 var(--font-body); }
  .row span { font-size: 14px; color: var(--muted); }
  .hours { text-align: left; margin-top: 20px; padding-top: 18px; border-top: 3px solid var(--line); }
  .hours-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .hours-head span { font-size: 10px; border: 2px solid var(--line); padding: 3px 5px; color: var(--muted); }
  .hours table { width: 100%; border-collapse: collapse; }
  .hours th, .hours td { padding: 9px 0; border-bottom: 2px dashed var(--line); font: 600 15px/1.2 var(--font-body); }
  .hours tr:last-child :is(th, td) { border-bottom: 0; }
  .hours th { text-align: left; }
  .hours td { text-align: right; color: var(--muted); }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 22px; }
</style>
