---
import Calendar from './Calendar.astro';
import { events, booked } from '../data/events';
import { site } from '../data/site';
---
<section id="events" class="events">
  <div class="wrap">
    <div class="sec-head">
      <div><div class="label kicker">Events</div><h2>CATCH THE HILUX</h2></div>
      <p>Where we're pouring next, and the dates you can book us for your own event.</p>
    </div>
    <div class="cal-cards">
      <article class="cal-card" data-cal-card>
        <h3>EVENT CALENDAR</h3>
        <Calendar mode="events" data={events} label="Event calendar" />
        <div class="legend label"><i class="sw ev"></i>Event day</div>
        <ul class="event-list" data-event-list></ul>
      </article>
      <article class="cal-card" data-cal-card>
        <h3>BOOK THE TRUCK</h3>
        <Calendar mode="booking" data={booked} label="Booking calendar" />
        <div class="legend label"><i class="sw free"></i>Free <i class="sw bk"></i>Booked <i class="sw sel"></i>Your pick</div>
        <div class="pick"><span class="label">Your date</span><b data-picked>Pick a free date</b></div>
        <a class="cb-btn" data-book data-base={site.whatsapp} href={site.whatsapp}>Request this date</a>
      </article>
    </div>
  </div>
</section>

<style>
  .events { border-top: 3px solid var(--line); }
  .cal-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: start; }
  @media (max-width: 820px) { .cal-cards { grid-template-columns: 1fr; } }
  .cal-card { background: var(--surface-100); border: 3px solid var(--line); box-shadow: var(--shadow-px-lg); padding: clamp(16px, 3vw, 28px); }
  .cal-card h3 { font: 700 20px/1 var(--font-display); color: var(--forest); margin-bottom: 16px; letter-spacing: .03em; }
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 12px; font-size: 10px; color: var(--muted); }
  .sw { display: inline-block; width: 12px; height: 12px; border: 2px solid var(--line); margin-right: 2px; }
  .sw.ev { background: var(--ember); } .sw.free { background: var(--surface-100); } .sw.bk { background: var(--surface-300); } .sw.sel { background: var(--forest); }
  .event-list { list-style: none; margin: 16px 0 0; padding: 0; }
  .event-list :global(li) { display: grid; gap: 2px; padding: 10px 0; border-top: 2px dashed var(--line); }
  .event-list :global(li .label) { font-size: 10px; color: var(--ember-600); }
  .event-list :global(li b) { font: 700 15px/1.2 var(--font-body); }
  .event-list :global(li small) { font-size: 13px; color: var(--muted); }
  .event-list :global(li.empty) { font-size: 14px; color: var(--muted); }
  .pick { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 16px 0; padding-top: 14px; border-top: 2px dashed var(--line); }
  .pick .label { font-size: 10px; color: var(--muted); }
  .pick b { font: 700 15px/1.2 var(--font-body); }
  .cal-card .cb-btn { width: 100%; justify-content: center; }
  .cal-card .cb-btn[aria-disabled] { opacity: .5; pointer-events: none; }
</style>
