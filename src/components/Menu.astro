---
import MenuCard from './MenuCard.astro';
import RoadLane from './RoadLane.astro';
import { drinks, snacks } from '../data/menu';
const panels = [{ id: 'drinks', pages: drinks }, { id: 'snacks', pages: snacks }];
// The other page's name, shown on both arrows (two pages per tab, so either arrow goes there).
const other = (pages: typeof drinks, i: number) => pages[(i + 1) % pages.length].title;
---
<div class="pin-track">
<section id="menu">
  <div class="wrap">
    <div class="sec-head">
      <div><div class="label kicker">The menu</div><h2>FROM THE TRAY</h2></div>
    </div>

    <div class="menu-tabs" role="tablist" aria-label="Menu">
      <button class="cb-btn" role="tab" id="tab-drinks" aria-controls="panel-drinks" aria-selected="true" data-tab="drinks">Drinks</button>
      <button class="cb-btn cb-btn--ghost" role="tab" id="tab-snacks" aria-controls="panel-snacks" aria-selected="false" data-tab="snacks" tabindex="-1">Snacks</button>
    </div>

    <!-- Each tab shows one page at a time (Drinks: Coffee, Non-coffee; Snacks: Burgers, Grill & bites), 4 across, filled
         row by row. The arrows either side flip the page and are tagged with the page they lead to. -->
    {panels.map((panel, k) => (
      <div class="menu-panel" id={`panel-${panel.id}`} role="tabpanel" aria-labelledby={`tab-${panel.id}`} data-pager data-page="0" hidden={k > 0}>
        <div class="side prev">
          <div class="stick">
            <button class="arrow" data-step="-1" aria-label={`Show ${other(panel.pages, 0)}`}><span class="chev" aria-hidden="true"></span></button>
            <span class="tag label" aria-hidden="true" data-other>{other(panel.pages, 0)}</span>
          </div>
        </div>
        <div class="pages-view">
          <div class="pages">
            {panel.pages.map((page, i) => (
              <div class="page" data-leads-to={other(panel.pages, i)} aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true}>
                <h3 class="label page-title">{page.title}</h3>
                <div class="menu-grid">
                  {page.items.map((item) => <MenuCard item={item} />)}
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="side next">
          <div class="stick">
            <button class="arrow" data-step="1" aria-label={`Show ${other(panel.pages, 0)}`}><span class="chev" aria-hidden="true"></span></button>
            <span class="tag label" aria-hidden="true" data-other>{other(panel.pages, 0)}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
  <RoadLane dir="ltr" scenery="town" road="asphalt" />
</section>
</div>

<script>
  // Drinks / Snacks tabs, and each tab's page flip (Coffee / Non-coffee, Burgers / Grill & bites) (arrows, arrow keys, or a sideways swipe).
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.menu-tabs [role="tab"]'));
  const showTab = (name: string) => {
    for (const t of tabs) {
      const on = t.dataset.tab === name;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      t.classList.toggle('cb-btn--ghost', !on);
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => showTab(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      n.focus(); showTab(n.dataset.tab!);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-pager]').forEach((pager) => {
    const pages = Array.from(pager.querySelectorAll<HTMLElement>('.page'));
    const go = (i: number) => {
      const n = (i + pages.length) % pages.length;
      pager.dataset.page = String(n);
      pager.style.setProperty('--page', String(n));
      pages.forEach((p, j) => { p.toggleAttribute('inert', j !== n); p.setAttribute('aria-hidden', String(j !== n)); });
      const other = pages[n].dataset.leadsTo ?? '';
      pager.querySelectorAll('[data-other]').forEach((el) => (el.textContent = other));
      pager.querySelectorAll('.arrow').forEach((b) => b.setAttribute('aria-label', `Show ${other}`));
      // after a flip on a long (phone) page, bring the page's top back into view
      const top = pager.getBoundingClientRect().top;
      if (top < 100) scrollBy({ top: top - 130, behavior: 'instant' as ScrollBehavior }); // under the sticky header
    };
    const cur = () => Number(pager.dataset.page) || 0;
    pager.querySelectorAll<HTMLButtonElement>('.arrow').forEach((b) => b.addEventListener('click', () => go(cur() + Number(b.dataset.step))));
    pager.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('.arrow') && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) go(cur() + (e.key === 'ArrowRight' ? 1 : -1));
    });
    // sideways swipe on touch screens
    let sx = 0, sy = 0;
    const view = pager.querySelector<HTMLElement>('.pages-view')!;
    view.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    view.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) go(cur() + (dx < 0 ? 1 : -1));
    }, { passive: true });
  });
</script>

<style>
  #menu { padding-bottom: 0; }
  #menu :global(.lane) { margin-top: 56px; }

  .menu-tabs { display: flex; justify-content: center; gap: 14px; margin-bottom: 28px; }
  .menu-tabs .cb-btn { min-width: 132px; }

  /* Pager: arrow column | sliding pages | arrow column. */
  .menu-panel { display: grid; grid-template-columns: 56px minmax(0, 1fr) 56px; gap: 12px; --page: 0; }
  .menu-panel[hidden] { display: none; }
  .side { position: relative; }
  /* The arrow and its tag stay in view while a long page scrolls past. They stick as one block, so at the bottom of the
     section the tag can't slide up over the arrow (it did when each stuck on its own). */
  .stick { position: sticky; top: 45vh; margin-top: 140px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .side .arrow { width: 48px; height: 48px; display: grid; place-items: center; padding: 0; cursor: pointer;
    background: var(--surface-100); color: var(--text); border: 3px solid var(--line); box-shadow: var(--shadow-px); }
  .side .arrow:hover { background: var(--ember); color: #fff6dc; }
  .side .arrow:active { transform: translate(3px, 3px); box-shadow: none; }
  .side .arrow:focus-visible { outline: 3px solid var(--ember); outline-offset: 3px; }
  /* Pixel chevron: a stepped triangle in the button's text colour. */
  .chev { width: 14px; height: 20px; background: currentColor;
    clip-path: polygon(0 0, 29% 0, 29% 10%, 43% 10%, 43% 20%, 57% 20%, 57% 30%, 71% 30%, 71% 40%, 100% 40%, 100% 60%, 71% 60%, 71% 70%, 57% 70%, 57% 80%, 43% 80%, 43% 90%, 29% 90%, 29% 100%, 0 100%); }
  .prev .chev { transform: scaleX(-1); }
  /* Tag under each arrow: the page it leads to, written down the side. */
  .side .tag { writing-mode: vertical-rl; font-size: 11px; letter-spacing: .14em; color: var(--ember-600); padding: 8px 4px;
    border: 2px solid var(--line); background: var(--surface-200); }
  .prev .tag { transform: rotate(180deg); }

  .pages-view { overflow: hidden; margin: -14px -10px -10px; }
  .pages { display: flex; transform: translateX(calc(var(--page) * -100%)); transition: transform .45s steps(9, end); }
  .page { flex: 0 0 100%; min-width: 0; padding: 14px 10px 10px; } /* room for the HOT stickers and card shadows */
  html[data-motion="reduce"] .pages { transition: none; }

  .page-title { display: flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: 13px; color: var(--ember-600); }
  .page-title::after { content: ""; flex: 1; border-top: 2px dashed var(--line); }
  /* 4 across, filled row by row. */
  .menu-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }


  /* Phones: two across (still row by row), slimmer arrow columns. */
  @media (max-width: 640px) {
    .menu-panel { grid-template-columns: 40px minmax(0, 1fr) 40px; gap: 8px; }
    .stick { margin-top: 60px; }
    .side .arrow { width: 38px; height: 38px; }
    .side .tag { font-size: 9px; }
    .menu-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
  }
</style>
