---
const steps = [
  { icon: 'bigpin', title: 'SPOT THE HILUX', text: "Check today's pin, then follow the smell of fresh coffee." },
  { icon: 'bigcup', title: 'ORDER AT THE TAILGATE', text: 'Pick a cup. We pull it fresh on the tray while you wait.' },
  { icon: 'tree', title: 'FIND A SPOT, CHILL', text: 'Grab a stool, sit on the grass, look at the view. No rush.' },
];
---
<section id="how">
  <div class="wrap">
    <div class="sec-head">
      <div><div class="label kicker">How it works</div><h2>3 STEPS TO CHILL</h2></div>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <canvas data-icon={s.icon} width="18" height="18" aria-hidden="true"></canvas>
          <div class="label">Step {String(i + 1).padStart(2, '0')}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } }
  .step { border: 3px solid var(--line); background: var(--surface-100); box-shadow: var(--shadow-px); padding: var(--space-6); }
  .step canvas { width: 72px; height: 72px; margin-bottom: 16px; }
  .step .label { color: var(--ember-600); }
  .step h3 { font: 700 22px/1.2 var(--font-display); color: var(--forest); margin: 6px 0 8px; letter-spacing: .02em; }
  .step p { margin: 0; color: var(--muted); font-size: 15px; }
</style>
