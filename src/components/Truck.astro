---
// The Chillbah Hilux: Niekki's artwork as a body layer, plus spinning wheel layers, an optional awning
// layer (hero only) and a headlight beam that shows in night mode. Art faces left; mirror the root to drive right.
// Images come in two sizes (760px and 1200px; wheels 96px and 151px) and the browser picks the one that's
// sharp enough for the screen. `sizes` is how wide the truck is drawn: the hero truck is 38.9% of the scene, which is
// wider than the screen on phones; road-lane trucks are clamp(220px, 30vw, 360px). Lane trucks load lazily.
interface Props { id?: string; class?: string; awning?: boolean; label?: string; lazy?: boolean; hero?: boolean }
const { id, class: className, awning = false, label, lazy = false, hero = false } = Astro.props;
const sizes = hero ? '(max-width: 720px) 52vw, 39vw' : '(max-width: 600px) 170px, (max-width: 733px) 220px, (max-width: 1200px) 30vw, 360px';
const wheelSizes = hero ? '(max-width: 720px) 8vw, 6vw' : '(max-width: 600px) 25px, (max-width: 733px) 32px, (max-width: 1200px) 4.4vw, 52px';
const loading = lazy ? 'lazy' : 'eager';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // site may live in a subfolder (GitHub Pages)
---
<div id={id} class:list={['truck', className]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <div class="shadow"></div>
  <div class="pool"></div>
  <div class="beam"></div>
  <div class="rig">
    <img class="body" src={`${B}hilux-body.webp`} srcset={`${B}hilux-body-760.webp 760w, ${B}hilux-body.webp 1200w`} sizes={sizes} width="1200" height="469" alt="" loading={loading} fetchpriority={hero ? 'high' : undefined} decoding="async" />
    <img class="wheel front" src={`${B}wheel-front.webp`} srcset={`${B}wheel-front-96.webp 96w, ${B}wheel-front.webp 151w`} sizes={wheelSizes} width="151" height="151" alt="" loading={loading} decoding="async" />
    <img class="wheel rear" src={`${B}wheel-rear.webp`} srcset={`${B}wheel-rear-96.webp 96w, ${B}wheel-rear.webp 151w`} sizes={wheelSizes} width="151" height="151" alt="" loading={loading} decoding="async" />
    {awning && <img class="awning" src={`${B}hilux-awning.webp`} srcset={`${B}hilux-awning-760.webp 707w, ${B}hilux-awning.webp 1115w`} sizes={sizes} width="1115" height="530" alt="" loading={loading} decoding="async" />}
  </div>
</div>

<style>
  .truck { position: relative; }
  /* Kept as a ready-to-move GPU layer only while the truck is near the screen (story.ts adds .near), so phones
     don't hold all five trucks and their wheels in memory at once. */
  .truck.near, .truck.near .wheel { will-change: transform; }
  .rig { position: relative; }
  /* Ground shadow: a flat, hard-edged pixel slab with stepped ends, tucked under the tyres. */
  .shadow { position: absolute; left: 2%; right: 3%; bottom: -1.2%; height: 5.5%; pointer-events: none;
    background: rgba(18, 18, 13, .28);
    clip-path: polygon(0 50%, 2% 50%, 2% 0, 98% 0, 98% 50%, 100% 50%, 100% 100%, 0 100%); }
  .body { display: block; width: 100%; height: auto; }
  /* Spinning hubs: the rim and inner tyre of each wheel, cut from the body art (1200×469). The outer tread stays in the body
     so the wheel-arch flares that overlap the tyre are never covered. */
  .wheel { position: absolute; width: 12.584%; height: auto; }
  .wheel.front { left: 10.637%; top: 63.854%; }
  .wheel.rear { left: 70.637%; top: 63.95%; }
  /* Opened tan awning with its poles (from Niekki's open-awning art), lined up on the body; it overhangs the back of the
     truck. It folds toward the roll on the roof (story.ts). */
  .awning { position: absolute; left: 24.607%; top: -1.342%; width: 92.884%; height: auto; transform-origin: 42% 4.5%; }

  /* Engine idle shake (story.ts adds .idling). */
  .truck.idling .rig { animation: idle .14s linear infinite; }
  @keyframes idle { 0%, 100% { transform: translate(0, 0); } 25% { transform: translate(-1px, -2px) rotate(-.3deg); } 50% { transform: translate(1px, 0); } 75% { transform: translate(0, -1px) rotate(.3deg); } }

  /* Headlights: a warm cone from the lamp (≈5%, 44% of the art) down onto the road ahead, plus a pool of light.
     Only at night, and only once the engine is on (story.ts adds .lights). */
  .beam { position: absolute; z-index: 0; right: 95%; top: 42%; width: 105%; height: 59%; opacity: 0; pointer-events: none;
    background: linear-gradient(to left, rgba(255, 236, 130, .95), rgba(255, 220, 90, .45) 55%, rgba(255, 214, 90, 0));
    clip-path: polygon(100% 0%, 100% 14%, 0% 100%, 0% 38%);
    mix-blend-mode: screen; transition: opacity .25s steps(3); }
  /* Bright pool where the beam hits the road. */
  .pool { position: absolute; z-index: 0; right: 86%; bottom: -2%; width: 130%; height: 26%; opacity: 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(255, 230, 110, .85), rgba(255, 214, 80, .4) 65%, rgba(255, 214, 80, 0));
    mix-blend-mode: screen; transition: opacity .25s steps(3); }
  .truck::after { content: ""; position: absolute; left: 3%; top: 39%; width: 6%; height: 12%; border-radius: 50%; opacity: 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(255, 245, 190, .95), rgba(255, 220, 100, 0)); mix-blend-mode: screen; transition: opacity .25s steps(3); }
  :global(:root[data-theme="dark"]) .truck.lights :is(.beam, .pool), :global(:root[data-theme="dark"]) .truck.lights::after { opacity: 1; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .truck.lights :is(.beam, .pool), :global(:root:not([data-theme="light"])) .truck.lights::after { opacity: 1; }
  }
</style>
