---
---
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="#top" aria-label="Chillbah home">
      <canvas data-cup="hot" data-liquid="#715542" width="16" height="16" style="width:32px;height:32px" aria-hidden="true"></canvas>
      <b>CHILLBAH</b>
    </a>
    <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
    <ul class="label" id="navLinks">
      <li><a href="#find">Find us</a></li>
      <li><a href="#menu">Menu</a></li>
      <li><a href="#how">How it works</a></li>
    </ul>
    <button class="theme-btn" id="themeBtn" type="button" aria-label="Switch day or night">
      <canvas data-theme-icon width="10" height="10" aria-hidden="true"></canvas>
    </button>
  </div>
</header>

<script>
  // Phone menu: the hamburger opens the links as a drop-down; picking one (or tapping outside) closes it.
  const btn = document.getElementById('menuBtn');
  const links = document.getElementById('navLinks');
  const setOpen = (open: boolean) => { links?.classList.toggle('open', open); btn?.setAttribute('aria-expanded', String(open)); btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); };
  btn?.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!links?.classList.contains('open')); });
  links?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.site-header')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: var(--surface-100); border-bottom: 3px solid var(--line); }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand b { font: 700 24px/1 var(--font-display); color: var(--forest); letter-spacing: .04em; }
  ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; }
  ul a { text-decoration: none; }
  ul a:hover { color: var(--ember-600); }
  .theme-btn { width: 40px; height: 40px; border: 3px solid var(--line); background: var(--surface-200); box-shadow: 3px 3px 0 var(--line); cursor: pointer; display: grid; place-items: center; padding: 0; }
  .theme-btn:focus-visible { outline: 3px dashed var(--forest); outline-offset: 4px; }
  .theme-btn canvas { width: 20px; height: 20px; }
  .menu-btn { display: none; width: 40px; height: 40px; margin-left: auto; border: 3px solid var(--line); background: var(--surface-200); box-shadow: 3px 3px 0 var(--line);
    cursor: pointer; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .menu-btn span { display: block; width: 18px; height: 3px; background: var(--line); }
  .menu-btn:focus-visible { outline: 3px dashed var(--forest); outline-offset: 4px; }
  @media (max-width: 720px) {
    .nav { gap: 10px; }
    .brand b { font-size: 20px; }
    .menu-btn { display: flex; }
    ul { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 0; background: var(--surface-100); border-bottom: 3px solid var(--line); }
    ul.open { display: flex; }
    ul a { display: block; padding: 16px 20px; font-size: 14px; border-top: 2px dashed var(--line); }
  }
</style>
