---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import FindUs from '../components/FindUs.astro';
import Events from '../components/Events.astro';
import PastEvents from '../components/PastEvents.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="top">
    <Hero />
    <FindUs />
    <Events />
    <Menu />
    <PastEvents />
  </main>
  <Footer />
</Base>

<script>
  import { reduceMotion, initMotionToggle } from '../lib/motion';
  import { initScene, sceneIcon, type SceneName } from '../scripts/scene';
  import { paint } from '../lib/pixel';
  import { drawArt, drawArtFaded, stopArtFade, initFireFlicker } from '../scripts/art';
  import { initThemeToggle, onThemeChange, isNight } from '../scripts/theme';
  import { initStory } from '../scripts/story';
  import { initCalendars } from '../scripts/calendar';
  import { initPress } from '../scripts/press';
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const scene = initScene(document.getElementById('scene') as HTMLCanvasElement | null);
  // Scene switch (Hero.astro): mountain or jetty, remembered between visits.
  const sceneBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-scene]')];
  const heroTruck = document.getElementById('heroTruck');
  const markScene = (name: SceneName) => {
    sceneBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.scene === name)));
    heroTruck?.setAttribute('aria-label', name === 'jetty'
      ? 'Pixel art of the white Chillbah Hilux with its tan side awning open on poles, parked on a jetty with the sea and small islands behind'
      : 'Pixel art of the white Chillbah Hilux with its tan side awning open on poles, parked on grass with mountains behind');
  };
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-scene-icon]').forEach((cv) => paint(cv, sceneIcon(cv.dataset.sceneIcon as SceneName)));
  markScene(scene.scene());
  sceneBtns.forEach((b) => b.addEventListener('click', () => { const name = b.dataset.scene as SceneName; scene.setScene(name); markScene(name); }));
  drawArt();
  initThemeToggle(document.getElementById('themeBtn'));
  initMotionToggle(document.getElementById('motionBtn'));
  onThemeChange(() => {
    scene.setNight(isNight());
    drawArtFaded();
  });
  let artTimer = 0;
  let artW = innerWidth;
  addEventListener('resize', () => {
    if (innerWidth === artW) return; // phones fire resize when the address bar slides; the art only depends on width
    artW = innerWidth;
    clearTimeout(artTimer); artTimer = window.setTimeout(() => { stopArtFade(); drawArt(); }, 120);
  });
  initStory();
  initCalendars();
  initPress();
  initFireFlicker();
  // Smooth, eased scrolling for mouse wheels and anchor links. Desktop only (touch screens keep their own scrolling,
  // so Lenis isn't loaded into the loop there at all). Off under reduced motion.
  // Its frame loop only runs while a scroll is actually happening, then stops, so a still page costs nothing.
  if (!reduceMotion() && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 94;
    const lenis = new Lenis({ lerp: 0.08, wheelMultiplier: 0.9, anchors: { offset: -(headerH + 8) } });
    let running = false, quiet = 0;
    const loop = (time: number) => {
      lenis.raf(time);
      quiet = lenis.isScrolling ? 0 : quiet + 1;
      if (quiet < 12) requestAnimationFrame(loop); else running = false; // a few spare frames, then sleep
    };
    const wake = () => {
      quiet = 0;
      if (running) return;
      running = true;
      (lenis as unknown as { time: number }).time = performance.now(); // so the first frame after a nap doesn't count the nap as elapsed time (that would make the scroll jump)
      requestAnimationFrame(loop);
    };
    ['wheel', 'keydown', 'click', 'pointerdown', 'scroll'].forEach((ev) => addEventListener(ev, wake, { passive: true, capture: true }));
    wake();
  }
</script>
