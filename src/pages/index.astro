---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import FindUs from '../components/FindUs.astro';
import Steps from '../components/Steps.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="top">
    <Hero />
    <Menu />
    <FindUs />
    <Steps />
  </main>
  <Footer />
</Base>

<script>
  import { initScene } from '../scripts/scene';
  import { drawArt } from '../scripts/art';
  import { initThemeToggle, onThemeChange, isNight } from '../scripts/theme';
  import { initStory } from '../scripts/story';

  const scene = initScene(document.getElementById('scene') as HTMLCanvasElement | null);
  drawArt();
  initThemeToggle(document.getElementById('themeBtn'));
  onThemeChange(() => {
    scene.setNight(isNight());
    drawArt();
    // let the page colours fade across with the sky
    document.documentElement.classList.add('theme-fade');
    clearTimeout(fadeTimer); fadeTimer = window.setTimeout(() => document.documentElement.classList.remove('theme-fade'), 1200);
  });
  let fadeTimer = 0;
  let artTimer = 0;
  addEventListener('resize', () => { clearTimeout(artTimer); artTimer = window.setTimeout(drawArt, 120); });
  initStory();
</script>
